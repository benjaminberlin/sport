// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  password      String
  role          String         @default("user") // "user" or "admin"
  coins         Int            @default(0)
  passValidUntil DateTime?
  moviesEnabled Boolean        @default(false)
  seriesEnabled Boolean        @default(false)
  lastOnline    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "admin_grant", "package_redeem"
  amount      Int      // coins added or deducted
  description String   // e.g., "Admin granted coins", "Redeemed 24h package"
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  logo        String
  streamUrl   String
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  programs    Program[]
}

model Program {
  id          String   @id @default(cuid())
  channelId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  @@index([channelId, startTime])
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  description String?
  poster      String?
  year        Int?
  genre       String?
  rating      Float?
  duration    Int?     // in minutes
  videoUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Series {
  id          String    @id @default(cuid())
  title       String
  description String?
  poster      String?
  year        Int?
  genre       String?
  rating      Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  episodes    Episode[]
}

model Episode {
  id          String   @id @default(cuid())
  seriesId    String
  seasonNumber Int
  episodeNumber Int
  title       String
  description String?
  duration    Int?     // in minutes
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  
  @@index([seriesId, seasonNumber, episodeNumber])
}
